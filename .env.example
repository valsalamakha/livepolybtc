# Polymarket CLOB L2 API credentials (required for LIVE trading only).
# Generate these from your Polymarket account / via the CLOB API key
# derivation flow. Never commit the populated .env file.
POLYMARKET_API_KEY=
POLYMARKET_SECRET=
POLYMARKET_PASSPHRASE=

# Optional: maker/funder wallet address (POLY_ADDRESS header).
POLYMARKET_ADDRESS=

# Optional: wallet private key for EIP-712 order signing. Required to submit
# REAL orders to the exchange. Leave empty to run in simulation/paper mode.
POLYMARKET_PRIVATE_KEY=

# Optional: force simulation mode regardless of the YAML setting.
# POLYMARKET_DRY_RUN=true
